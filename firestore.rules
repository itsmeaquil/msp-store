rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can browse the accessory catalog; only the signed-in admin can add/edit/remove items.
    match /accessories/{accessoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ticket IDs (e.g. REP-1042) act like a tracking number — whoever has the ID can look up
    // that ticket, same as a courier tracking number. Only the signed-in admin can create,
    // update, or delete tickets.
    match /repair_tickets/{ticketId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can submit an inquiry; only the admin can read or manage the inbox.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public store info (address, hours, contact); only the admin can edit it.
    match /store_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Repair estimator pricing matrix; anyone browsing the estimator needs to read it,
    // only the admin can update prices.
    match /pricing/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
